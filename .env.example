HTTP_PORT=8080
# Use a specific LAN address or 127.0.0.1 to restrict the listening interface.
BIND_ADDRESS=0.0.0.0
PRODUCT_PROVIDER=amazon_page
# stable, decreasing, increasing, temporary, recovered
MONITOR_MOCK_SCENARIO=stable
# Worker polling interval in seconds (minimum 60).
POLL_INTERVAL_SECONDS=21600
# Retry interval after a failed check in seconds (minimum 60).
FAILED_RETRY_SECONDS=60
# Minimum delay between all Amazon requests from the worker (seconds, minimum 60).
QUEUE_GAP_SECONDS=180
